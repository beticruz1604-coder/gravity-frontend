# ── IP real del cliente ─────────────────────────────────────────────────────
# Cloud Run añade la IP del cliente al FINAL de X-Forwarded-For; sin recursividad nginx toma justo esa (no la que el cliente
# pueda haber escrito antes), y es la que usan los límites de abajo.
set_real_ip_from 0.0.0.0/0;
real_ip_header X-Forwarded-For;
real_ip_recursive off;

# ── Límites de peticiones por IP (frenan el abuso mientras el front siga público) ─
limit_req_status 429;
limit_req_zone $binary_remote_addr zone=lecturas:10m rate=60r/s;
# Las escrituras (POST, etc.) tienen un límite propio mucho menor; las lecturas llevan clave vacía y no cuentan aquí.
map $request_method $clave_escritura {
  default "";
  POST    $binary_remote_addr;
  PUT     $binary_remote_addr;
  PATCH   $binary_remote_addr;
  DELETE  $binary_remote_addr;
}
limit_req_zone $clave_escritura zone=escrituras:10m rate=10r/s;

# ── Credencial hacia Backstage ──────────────────────────────────────────────
# Solo pasa el «Authorization: Bearer <token>» del navegador (el token de la persona, que Backstage emitió al iniciar sesión):
# Backstage lo valida y así sabe quién es. Sin él no se envía credencial y Backstage responde 401: el proxy no aporta identidad propia.
map $http_authorization $backstage_authorization {
  "~^Bearer\ .+" $http_authorization;
  default        "";
}

# ── Lista de rutas de Backstage que el front necesita ──────────────────────
# Todo lo demás recibe 403. Se evalúa sobre $uri (ya decodificado y normalizado: «..» y %2e%2e no pasan) y el método.
# Para el registro de un componente por URL solo se permite la simulación (dryRun); registrarlo de verdad queda bloqueado
# mientras no haya identidad por usuario.
map "$request_method $uri $args" $ruta_permitida {
  default 0;

  ~^(GET|HEAD)\ /backstage/api/(catalog/entities|catalog/entities/by-name/[^/]+/[^/]+/[^/]+|scorecards/components|kubernetes/clusters|techdocs/metadata/techdocs/[^/]+/component/[^/]+|techdocs/static/docs/[^/]+/component/[^/]+/(?!.*\.\.)[A-Za-z0-9._/-]*)\ .*$ 1;
  ~^(GET|HEAD)\ /backstage/api/homologation/(items|health|components|baseline|requirements)(/[^/]+)?\ .*$ 1;
  ~^(GET|HEAD)\ /backstage/api/branching/(rules|health|pipelines/[^/]+|agent-pools/[^/]+|repositories/[^/]+/[^/]+|branches/[^/]+/[^/]+|policies/[^/]+/[^/]+)\ .*$ 1;
  ~^(GET|HEAD)\ /backstage/api/access/(me|roles|users|products)\ .*$ 1;
  # Historial de informes de Release Management (solo lectura).
  ~^(GET|HEAD)\ /backstage/api/rm/(reports|reports/[0-9a-f]+|components)\ .*$ 1;
  # Inicio de sesión del laboratorio (usuario y contraseña): Backstage entrega el token de la persona en /auth/lab/refresh.
  ~^(GET|HEAD)\ /backstage/api/auth/lab/refresh\ .*$ 1;
  ~^(GET|HEAD)\ /backstage/api/scaffolder/v2/(tasks|tasks/[^/]+|tasks/[^/]+/events|templates/default/template/[^/]+/parameter-schema)\ .*$ 1;

  ~^POST\ /backstage/api/scaffolder/v2/(tasks|tasks/[^/]+/cancel)\ .*$ 1;
  # Administración de usuarios (Backstage exige Admin) y cambio de la propia contraseña.
  ~^POST\ /backstage/api/access/(users|users/[a-z]+\.[a-z]+/reset-password|me/password|products)\ .*$ 1;
  ~^(PATCH|DELETE)\ /backstage/api/access/users/[a-z]+\.[a-z]+\ .*$ 1;
  ~^POST\ /backstage/api/branching/(preview|branch-name|validate)\ .*$ 1;
  ~^POST\ /backstage/api/kubernetes/services/[^/]+\ .*$ 1;
  ~^POST\ /backstage/api/catalog/locations\ (dryRun=true)?$ 1;
}

server {
  listen 8080;
  server_tokens off;
  client_max_body_size 1m;
  root /usr/share/nginx/html;
  index index.html;

  # El navegador llama a /backstage/... y el servidor lo reenvía a Backstage por la red privada (mismo origen, sin CORS).
  # Backstage decide si el rol de la persona permite esta llamada (GET /api/access/authorize), sin ver el cuerpo.
  location = /_autorizar {
    internal;
    proxy_pass ${BACKSTAGE_URL}/api/access/authorize;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    include /etc/nginx/snippets/backstage-tls.conf;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host ${BACKSTAGE_HOST};
    proxy_set_header Authorization $backstage_authorization;
    proxy_set_header X-Original-Uri $ruta_original;
    proxy_set_header X-Original-Method $request_method;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
  }

  location @sin_permiso {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    return 403 '{"error":{"message":"Tu rol no permite esta acción."}}';
  }

  # Si la consulta anterior falla (VM apagada), nginx daría 500; 503 es lo que el front reintenta como caída breve.
  location @backstage_no_disponible {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    return 503 '{"error":{"message":"Backstage no está disponible."}}';
  }

  location /backstage/ {
    if ($ruta_permitida = 0) {
      return 403;
    }
    # Dentro de la subpetición $uri ya es /_autorizar: la ruta original (decodificada y normalizada) se guarda antes.
    set $ruta_original $uri;
    auth_request /_autorizar;
    error_page 403 = @sin_permiso;
    error_page 500 = @backstage_no_disponible;
    limit_req zone=lecturas burst=120 nodelay;
    limit_req zone=escrituras burst=20 nodelay;

    proxy_pass ${BACKSTAGE_URL}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    include /etc/nginx/snippets/backstage-tls.conf;
    proxy_set_header Host ${BACKSTAGE_HOST};
    proxy_set_header Authorization $backstage_authorization;
    # Con Backstage apagado (la VM se apaga para ahorrar) la conexión no debe quedarse esperando: Cloud Run factura el CPU
    # mientras la petición está abierta, y las comprobaciones de disponibilidad la repiten cada 5 minutos desde varias regiones.
    proxy_connect_timeout 3s;
    proxy_read_timeout 120s;
    include /etc/nginx/snippets/security-headers.conf;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
  }

  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri /index.html;
  }
}
