server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # El navegador llama a /backstage/... y el servidor lo reenvía a Backstage por la red privada (mismo origen, sin CORS).
  location /backstage/ {
    proxy_pass ${BACKSTAGE_URL}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host ${BACKSTAGE_HOST};
    proxy_read_timeout 120s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
